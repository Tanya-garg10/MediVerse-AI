{
    "buildCommand": "bun run build",
    "installCommand": "bun install",
    "framework": null,
    "outputDirectory": "dist/client",
    "functions": {
        "dist/server/server.js": {
            "runtime": "nodejs22.x"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/server/server.js"
        }
    ]
}